# Database
DATABASE_URL=postgresql://user:password@localhost:5432/clutch_viewership

# Twitch API
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret

# YouTube API
YOUTUBE_API_KEY=your_youtube_api_key

# Kick API (register at kick.com/settings/developer)
KICK_CLIENT_ID=your_kick_client_id
KICK_CLIENT_SECRET=your_kick_client_secret

# Trovo API (register at developer.trovo.live)
TROVO_CLIENT_ID=your_trovo_client_id
TROVO_CLIENT_SECRET=your_trovo_client_secret

# Server
PORT=3000
WS_PORT=3001

# Polling
POLLING_INTERVAL_MS=60000
DISCOVERY_INTERVAL_MS=120000

# Logging
LOG_LEVEL=info
